{
  "name": "@mufessir/backend",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests eslint.config.js",
    "start": "node dist/src/index.js",
    "test": "TEST_RUN_ID=\"run_$(date +%s)_$$\"; export TEST_RUN_ID; tsx scripts/test-db.ts prepare && vitest run; rc=$?; tsx scripts/test-db.ts teardown || rc=1; exit $rc",
    "test:coverage": "TEST_RUN_ID=\"run_$(date +%s)_$$\"; export TEST_RUN_ID; tsx scripts/test-db.ts prepare && vitest run --coverage; rc=$?; tsx scripts/test-db.ts teardown || rc=1; exit $rc",
    "test:traceability": "vitest run tests/traceability.test.ts",
    "test:watch": "vitest",
    "seed": "node scripts/insert-sample-data.js",
    "generate-chunks": "tsx scripts/generate-chunks.ts",
    "generate-embeddings": "tsx scripts/generate-embeddings.ts",
    "generate-embeddings:local": "tsx scripts/generate-embeddings-local.ts",
    "generate-embeddings:safe": "tsx scripts/generate-embeddings-slow.ts",
    "derive-scholar-metadata": "tsx scripts/derive-scholar-metadata.ts",
    "quality:scholars": "tsx scripts/check-scholar-data-quality.ts",
    "export-scholar-enrichment-starter": "tsx scripts/export-scholar-enrichment-starter.ts",
    "import-scholar-enrichment": "tsx scripts/import-scholar-enrichment-csv.ts",
    "import-sqlite": "tsx scripts/import-sqlite.ts",
    "import-mysql-dump": "tsx scripts/import-mysql-dump.ts",
    "copy-users": "tsx scripts/copy-users.ts",
    "import-users-csv": "tsx scripts/import-users-csv.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.6",
    "express": "4.22.3",
    "jsonwebtoken": "^9.0.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "10.0.13",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "gpt-tokenizer": "^3.4.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.9"
  }
}